# 复制为 .env 后填入真实值；.env 必须被 .gitignore 忽略，禁止提交。
# 本文件所有值均为占位符，禁止出现任何真实密钥。

# --- App ---
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8772
CORS_ORIGINS=http://localhost:8772,http://127.0.0.1:8772
DEMO_MODE=true
LOG_LEVEL=INFO
LOG_PATH=./logs/app.jsonl

# --- 上游与 Provider 适配器 ---
# mock = 本地确定性模拟（默认，无需任何密钥，评测可复现）；http = 走真实 HTTP 上游
PROVIDER_MODE=mock
UPSTREAM_BASE_URL=http://localhost:9000/v1
UPSTREAM_API_KEY=YOUR_UPSTREAM_KEY_HERE
MODEL_NAME=mock-deepseek-v3

# --- LLM 调用参数（必须显式设置，代码不设隐式默认值）---
LLM_TIMEOUT_MS=10000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
PROMPT_VERSION=quota-router-cn-v1.0.0

# --- Agent / 检索 / 上下文 ---
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.5
MAX_INPUT_CHARS=4000
HISTORY_MAX_TURNS=6
RANDOM_SEED=20261112

# --- 额度与路由状态机 ---
DB_PATH=./data/margin.db
POLL_INTERVAL_S=6
QUOTA_WARN_THRESHOLD=0.10
AUTO_SWITCH=true
FALLBACK_CHAIN=deepseek,qwen,glm
NOTIFY_IN_APP=true
NOTIFY_EMAIL=false
NOTIFY_WEBHOOK=false

# --- 容器网络（仅 docker compose 使用）---
# bridge = 默认且推荐。ports 映射生效，容器可访问厂商 API。
# host   = 仅在 dockerd 的 iptables 被禁用、暂时无法修复时的临时绕行方案；
#          host 模式下 compose 的 ports 会被忽略（有告警），且依赖 WSL 实例常驻。
# WSL2 原生 dockerd 若 bridge 出站不通，根因通常是 dockerd 以 --iptables=false
# 启动（缺 MASQUERADE / DNAT）。执行 `bash install.sh fix-network` 或修正
# dockerd 启动参数后即可用 bridge，无需 host。
SFP_NETWORK_MODE=bridge

# --- SafeShell Pro：raw 透传（客户端 → 免费模型）---
# 按客户端令牌桶限流（RPM）；0 表示不限。默认 30 对齐 GLM 免费档
RAW_RPM_PER_CLIENT=30
# 转发上游超时（秒）。SiliconFlow 部分开源模型冷启动 30~40s，默认放宽到 60
RAW_UPSTREAM_TIMEOUT_S=60
# 按模型分级超时（JSON）：快模型快速失败、慢模型保留冷启动余量；未命中用上面的全局值
RAW_MODEL_TIMEOUTS={"glm-4-flash":12,"Qwen/Qwen2.5-7B-Instruct":20,"Qwen/Qwen3-8B":30,"deepseek-ai/DeepSeek-R1-0528-Qwen3-8B":45,"THUDM/GLM-4-9B-0414":50,"glm-4.7-flash":12}
# 启动预热（逗号分隔，留空=不预热）。会消耗免费额度，仅需要消除首调冷启动时开启，如 glm-4-flash
WARMUP_MODELS=
# 可选共享令牌（默认空 = 完全不鉴权，本机/内网零配置）。
# 面向互联网开放服务前务必设置：所有 /api/v1 端点（除 health）都需带 X-API-Token 或 Bearer。
# 客户端对应 SHELLMATE_CLOUD_TOKEN；前端控制台「访问令牌」输入框可保存。
SAFESHELL_API_TOKEN=

# --- 故障注入（仅测试使用，生产保持 false）---
FAULT_INJECT_TIMEOUT=false
FAULT_INJECT_PARSE_ERROR=false
FAULT_INJECT_RATE_LIMIT=false
